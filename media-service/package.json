    "@types/multer": "^2.2.0",
    "@types/node": "^22.0.0",
    "@yao-pkg/pkg": "^6.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
